{
  "name": "Dissonance",
  "productName": "Dissonance",
  "version": "0.1.1",
  "private": true,
  "description": "Silencing AI, Preserving Sound",
  "main": "main.js",
  "scripts": {
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./tailwind.input.css -o ./tailwind.css",
    "watch:css": "tailwindcss -c ./tailwind.config.js -i ./tailwind.input.css -o ./tailwind.css --watch",
    "prestart": "npm run build:css",
    "predev": "npm run build:css",
    "prebuild": "npm run build:css",
    "start": "electron .",
    "dev": "electron .",
    "dev:with-core": "npm run build:core && npm run build:css && DISSONANCE_CORE_ADDON_PATH=../core/build/Release/dissonance_core.node electron .",
    "build:core": "cd ../core && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "build": "electron-builder --dir",
    "predist": "npm run build:css",
    "dist": "electron-builder --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.dissonanceeip.dissonance",
    "productName": "Dissonance",
    "directories": {
      "buildResources": "resources"
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "@arraypress/waveform-player": "^1.5.2",
    "bindings": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.7"
  }
}
